---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_32.png" />
    <title>Privacy policy | Maker Margin</title>
  </head>
  <body class="min-h-screen bg-[#F4ECDD] px-6 py-16 text-[#1C1A17] antialiased">
    <main class="mx-auto max-w-2xl">
      <a class="text-sm text-[#A23E0E] underline underline-offset-4" href="/">Back to Maker Margin</a>
      <h1 class="mt-8 font-serif text-5xl">Privacy policy</h1>
      <div class="mt-8 space-y-5 text-base leading-7 text-[#312d27]">
        <p>
          Maker Margin collects email addresses through Beehiiv when you subscribe for product updates.
          We use that email to send Maker Margin updates, rate-change notes, and new-tool announcements.
        </p>
        <p>
          We do not sell subscriber data. You can unsubscribe from any email using the link in that email.
        </p>
        <p>
          This page is a placeholder policy while Maker Margin is in v1. It will be replaced with a fuller
          policy before additional tracking, forms, or account features are added.
        </p>
      </div>
    </main>
  </body>
</html>
